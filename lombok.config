# Managed by the truesim.settings plugin (true-sim/build-logic) and overwritten on every build.
# To take ownership of this file, delete this header block.
# To override settings for one module, add a lombok.config in that module; nearer files win.

# This is the root config: don't pick up lombok.config files from parent directories.
config.stopBubbling = true

# Mark generated code with @lombok.Generated so JaCoCo and other coverage tools ignore it.
lombok.addLombokGeneratedAnnotation = true

# Accessors follow the JavaBeans convention (getName/setName/isActive), which Jackson,
# JPA/Hibernate, Spring and bean introspection rely on. No fluent or chained setters;
# use records, @Builder or @With for fluent construction.
lombok.accessors.fluent = false
lombok.accessors.chain = false

# Generated loggers use SLF4J and are named `log`.
lombok.log.fieldName = log

# Discourage features with better alternatives or surprising behavior.
# `val`/`var`: use Java's `var` (or `final var`) instead.
lombok.val.flagUsage = warning
lombok.var.flagUsage = error
# Experimental features may change or be removed between Lombok releases.
lombok.experimental.flagUsage = warning
# Hides checked exceptions from callers.
lombok.sneakyThrows.flagUsage = warning
